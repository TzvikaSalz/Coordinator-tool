# Copy to .env. Credentials are read by the server, never sent to the browser.
PORT=4180
# GoHighLevel private integration, read-only scopes. Never use VITE_ for secrets.
GHL_API_KEY=
GHL_LOCATION_ID=
# Map your location's custom field IDs. See README for recognized status values.
GHL_FIELD_MAP={"procedure":"","consultDate":"","followUpAt":"","surgeryDate":"","status":""}
CRM_BASE_URL=
CRM_API_KEY=
# Normalized REST adapter: see README.md. Native provider mapping comes next.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REVIEW_MODEL=gpt-6.1-sol
AI_CONFIDENCE_THRESHOLD=0.8
# Local-only until authentication and deployment controls are added.
HOST=127.0.0.1
